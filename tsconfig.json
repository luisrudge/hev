{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "@cloudflare/workers-types", "vite/client"],
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true
  },
  "include": ["src", "worker", "alchemy.run.ts", "vite.config.ts"]
}
